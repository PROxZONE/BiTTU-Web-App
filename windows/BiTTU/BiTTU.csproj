<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BiTTU</AssemblyName>
    <RootNamespace>BiTTU</RootNamespace>
    <!-- Lets this project compile on non-Windows hosts (CI checks); it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- Dark HTTPS-only warning page, embedded so single-file publish keeps it. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/warning.html" LogicalName="BiTTU.warning.html" />
  </ItemGroup>

  <!-- Same bundled rule lists the macOS app ships. -->
  <ItemGroup>
    <Content Include="../../Sources/BiTTU/Resources/blocklists/*.json"
             Link="blocklists/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
